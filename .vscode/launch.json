      "type": "dart",
      "program": "lib/main.dart",
      "deviceId": "chrome",
      "args": ["--web-port", "8080", "--dart-define-from-file=config.json"]
    },
    {
      "name": "CrowdTech (téléphone Android)",
      "request": "launch",
      "type": "dart",
      "program": "lib/main.dart",
      "args": ["--dart-define-from-file=config.json"]
    }
  ]
}
