{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "CrowdTech (Windows)",
      "request": "launch",
      "type": "dart",
      "program": "lib/main.dart",
      "deviceId": "windows",
      "args": ["--dart-define-from-file=config.json"]
    },
    {
      "name": "CrowdTech (Chrome, port 8080)",
