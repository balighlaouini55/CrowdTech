rules_version = '2';

// Règles Firestore de CrowdTech (plan Spark).
// À coller dans la console Firebase : Firestore Database → Règles → Publier.
//
// Limite connue : sans serveur (Cloud Functions exige le plan payant Blaze),
// les collections partagées restent modifiables par tout compte connecté, car
// un investisseur doit pouvoir mettre à jour la collecte d'un projet. Ces
// règles bloquent l'accès anonyme, protègent les données personnelles et
// empêchent de s'attribuer le rôle Admin ; elles ne remplacent pas un serveur.
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function selfServiceRole(role) {
      return role in ['Lecteur', 'Investisseur', 'Porteur de projet'];
    }

    // Fiche du compte : seul son propriétaire la lit et la modifie. Le rôle ne
    // peut pas devenir Admin depuis l'application.
    match /users/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow create: if signedIn() && request.auth.uid == uid
        && selfServiceRole(request.resource.data.role);
      allow update: if signedIn() && request.auth.uid == uid
        && (request.resource.data.role == resource.data.role
            || selfServiceRole(request.resource.data.role));
      allow delete: if false;

      // Panier, favoris, profil, journal… : réservés au propriétaire.
      match /{collection}/{document} {
        allow read, write: if signedIn() && request.auth.uid == uid;
      }
    }

    // Collections partagées (liste de FirebaseSync.sharedCollections).
    match /{collection}/{document} {
      allow read, write: if signedIn() && collection in [
        'news', 'news_comments', 'news_votes', 'comment_reports',
        'funding', 'investments', 'project_features', 'project_questions',
        'project_updates', 'milestones', 'token_packs', 'token_listings',
        'exchange_rates', 'products', 'orders', 'seller_reviews',
        'events', 'reservations', 'waitlist'
      ];
    }
  }
}
